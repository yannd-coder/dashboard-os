        "httpMethod": "POST",
        "path": "m02-trigger",
        "options": {}
      }
    },
    {
      "name": "Email IMAP",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [
        0,
        220
      ],
      "disabled": true,
      "parameters": {
        "mailbox": "INBOX",
        "format": "simple",
