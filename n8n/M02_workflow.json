        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_run_id: $('Create Run').item.json.data, p_status: \"success\", p_summary: \"Email ignoré (non-prospect) : \" + JSON.parse($('Claude Classify').item.json.content[0].text.replace(/```json|```/g, '').trim()).summary }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      }
    }
