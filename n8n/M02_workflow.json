        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  p_prospect_id: $('Insert Prospect').item.json.data,\n  p_content: $('Claude Reply').item.json.content[0].text\n}) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      }
    },
    {
      "name": "Complete Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://flqjaqocsugwbkbiuhhk.supabase.co/rest/v1/rpc/dashboard_complete_machine_run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "sb_publishable_ZEztH4rLAFrFBBYGEhRy9w_FOiCic-m"
            },
            {
              "name": "Authorization",
              "value": "Bearer sb_publishable_ZEztH4rLAFrFBBYGEhRy9w_FOiCic-m"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
