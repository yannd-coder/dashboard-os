        "jsonBody": "={{ (() => {\n  const photoUrl = $('Pick Photo').item.json.public_url || '';\n  const claudeRaw = $('Claude FB').item.json.content[0].text;\n  let accroche = 'Bienvenue';\n  try { accroche = JSON.parse(claudeRaw).accroche_visuel || accroche; } catch(e) {}\n  const qs = 'format=square'\n    + '&photo=' + encodeURIComponent(photoUrl)\n    + '&accroche=' + encodeURIComponent(accroche)\n    + '&l1=' + encodeURIComponent('VILLA COLIVER')\n    + '&l2=' + encodeURIComponent('SAINT-PIERRE');\n  const url = 'http://dashboard:80/templates/visual.html?' + qs;\n  return JSON.stringify({\n    url: url,\n    options: { type: 'png', clip: { x: 0, y: 0, width: 1080, height: 1080 } },\n    viewport: { width: 1080, height: 1080, deviceScaleFactor: 1 },\n    gotoOptions: { waitUntil: 'networkidle0', timeout: 20000 }\n  });\n})() }}",
