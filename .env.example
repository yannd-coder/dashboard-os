# App
VITE_APP_NAME="YANN OS"

# Supabase (projet kor-app — Europe West)
# Récupérer URL + clé publishable dans Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Browserless (V0.6 — moteur HTML→PNG pour les visuels M01)
# Optionnel : si vide, le service utilise un fallback hardcodé (OK car écoute seulement 127.0.0.1).
# Pour renforcer : `openssl rand -hex 32` puis ajouter en secret GH Actions.
BROWSERLESS_TOKEN=
